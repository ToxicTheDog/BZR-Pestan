# Port HTTP servera
PORT=4000
# Tajna za potpisivanje JWT tokena — u produkciji obavezno promeniti
JWT_TAJNA=promeni-me-u-produkciji
# Koliko sati traje token
JWT_SATI=12
# Odakle frontend sme da zove API (zarezom razdvojeno)
CORS_IZVOR=http://localhost:5173,http://localhost:4173
# Putanja do JSON baze
BAZA_PUTANJA=./podaci/baza.json
